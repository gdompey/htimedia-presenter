{
  "name": "htimedia-presenter",
  "productName": "HTIMedia Presenter",
  "version": "1.2.0",
  "description": "Local-first worship and live presentation software for Heroes' Temple International. Runs fully offline on macOS and Windows.",
  "main": "src/main/main.js",
  "author": "GABCEL Labs for Heroes' Temple International",
  "license": "MIT",
  "homepage": "https://github.com/gdompey/htimedia-presenter",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdompey/htimedia-presenter.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:icons": "electron scripts/build-icons.js",
    "build:resources": "node scripts/build-resources.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder",
    "selftest": "node scripts/run-selftest.js",
    "build:fonts": "node scripts/build-fonts.js"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.heroestemple.htimedia-presenter",
    "productName": "HTIMedia Presenter",
    "copyright": "Copyright (c) 2026 GABCEL Labs for Heroes Temple International",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/bundled/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/build/pdf.mjs",
      "!node_modules/pdfjs-dist/build/pdf.worker.mjs",
      "!node_modules/pdfjs-dist/build/pdf.sandbox*",
      "!node_modules/@napi-rs/**",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/worker*",
      "!node_modules/sql.js/dist/sql-wasm-browser*",
      "!node_modules/sql.js/dist/sqljs-*",
      "!node_modules/@fontsource/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "HTIMedia-Presenter-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "HTIMedia Presenter ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "HTIMedia Presenter",
      "artifactName": "HTIMedia-Presenter-Setup-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "HTIMedia-Presenter-${version}-win-x64-portable.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.12.0"
  }
}
